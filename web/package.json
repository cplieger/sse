{
  "name": "@cplieger/sse",
  "version": "1.0.0",
  "description": "Server-Sent Events hub and client that resume from an exact cursor and reconcile after sleep",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cplieger/sse.git",
    "directory": "web"
  },
  "homepage": "https://github.com/cplieger/sse",
  "bugs": {
    "url": "https://github.com/cplieger/sse/issues"
  },
  "author": "cplieger <917744+cplieger@users.noreply.github.com>",
  "keywords": [
    "sse",
    "server-sent-events",
    "eventsource",
    "reconnect",
    "resume",
    "sharedworker",
    "typescript"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src/",
    "!src/**/*.test.ts",
    "!src/**/*-setup.ts",
    "!src/**/test-helpers/**",
    "!src/**/*.golden.json",
    "jsr.json",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE",
    "NOTICE"
  ],
  "sseFixture": "./ssetest/cmd",
  "browserEngines": [
    "firefox",
    "webkit"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.tests.json",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "test": "vitest --run",
    "test:browser": "vitest --run --project browser",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier --check .",
    "lint:knip": "knip",
    "lint:fix": "eslint . --fix && prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/typescript-checker": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "24.13.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/browser": "5.0.1",
    "@vitest/browser-playwright": "5.0.1",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.11.0",
    "eventsource-parser": "4.1.1",
    "fast-check": "4.10.2",
    "knip": "6.38.0",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1"
  },
  "overrides": {
    "qs": "^6.15.2"
  }
}
